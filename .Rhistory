# Load necessary libraries
library(tidyverse)
# Simulate data for 30 participants over 60 choice trials
set.seed(42)
n_participants <- 30
n_trials <- 60
# Create a data frame
sim_data <- expand.grid(
participant = 1:n_participants,
trial = 1:n_trials,
block = 2:7
)
# Simulate choices (more likely to choose Kitchen early on)
sim_data$scene_choice <- ifelse(
sim_data$trial < 30,
sample(c("High-associations", "No associations"), size = nrow(sim_data), replace = TRUE, prob = c(0.75, 0.25)),
sample(c("High-associations", "No associations"), size = nrow(sim_data), replace = TRUE, prob = c(0.5, 0.5))
)
# Simulate accuracy
sim_data$accuracy <- ifelse(
sim_data$scene_choice == "High-associations",
rbinom(nrow(sim_data), 1, prob = 0.85),  # higher accuracy in Kitchen
rbinom(nrow(sim_data), 1, prob = 0.65)   # lower in Bathroom
)
# Calculate overall proportion of scene choice
choice_summary <- sim_data %>%
group_by(scene_choice) %>%
summarise(proportion = n() / nrow(sim_data))
# Accuracy by scene type
accuracy_summary <- sim_data %>%
group_by(scene_choice) %>%
summarise(accuracy = mean(accuracy))
# Plot: Proportion of scene choices
ggplot(choice_summary, aes(x = scene_choice, y = proportion, fill = scene_choice)) +
geom_col() +
labs(title = "Proportion of Scene Choices", y = "Proportion", x = "Scene") +
theme_minimal() +
scale_fill_manual(values = c("High-associations" = "#FFAA00", "No associations" = "#00BFFF"))
# Plot: Accuracy by scene
ggplot(accuracy_summary, aes(x = scene_choice, y = accuracy, fill = scene_choice)) +
geom_col() +
labs(title = "Accuracy by Scene Type", y = "Accuracy", x = "Scene") +
theme_minimal() +
scale_fill_manual(values = c("High-associations" = "#FFAA00", "No associations" = "#00BFFF"))
# Plot: Proportion choosing Kitchen over time (optional)
proportion_by_trial <- sim_data %>%
group_by(trial) %>%
summarise(prop_kitchen = mean(scene_choice == "High-associations"))
ggplot(proportion_by_trial, aes(x = trial, y = prop_kitchen)) +
geom_line(color = "#FFAA00", size = 1.2) +
geom_smooth(se = FALSE, linetype = "dashed", color = "gray40") +
labs(title = "Preference for scene with High-association Over Time",
x = "Trial Number", y = "Proportion Choosing High-associated scene") +
theme_minimal()
# Simulate reward outcomes per trial
sim_data$reward <- ifelse(
sim_data$scene_choice == "High-associations",
rbinom(nrow(sim_data), 1, prob = 0.25) * 0.10,
rbinom(nrow(sim_data), 1, prob = 0.75) * 0.10
)
# Summarize reward and choice proportions per participant
participant_summary <- sim_data %>%
group_by(participant) %>%
summarise(
prop_bathroom = mean(scene_choice == "No associations"),
prop_kitchen = mean(scene_choice == "High-associations"),
total_reward = sum(reward)
)
# Correlation between bathroom choice rate and total earnings
cor_test <- cor.test(participant_summary$prop_bathroom, participant_summary$total_reward)
# Print correlation test results
print(cor_test)
# Plot correlation
ggplot(participant_summary, aes(x = prop_bathroom, y = total_reward)) +
geom_point(size = 3, color = "#00BFFF", alpha = 0.6) +
geom_smooth(method = "lm", color = "black", linetype = "dashed") +
labs(
title = "Correlation between proportion of scene with\nno-associaitons (but high reward) and total reward earned",
subtitle = paste("r =", round(cor_test$estimate, 2), ", p =", round(cor_test$p.value, 3)),
x = "Proportion Choosing Bathroom",
y = "Total Reward Earned ($)"
) +
theme_minimal()
# Plot correlation
ggplot(participant_summary, aes(x = prop_bathroom, y = total_reward)) +
geom_point(size = 3, color = "#00BFFF", alpha = 0.6) +
geom_smooth(method = "lm", color = "black", linetype = "dashed") +
labs(
title = "Correlation between proportion of scene with\nno-associaitons (but high reward) and total reward earned",
subtitle = paste("r =", round(cor_test$estimate, 2), ", p =", round(cor_test$p.value, 3)),
x = "Proportion Choosing Scene with no association but high reward",
y = "Total Reward Earned ($)"
) +
theme_minimal()
