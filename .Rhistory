ggplot(participant_summary, aes(x = prop_bathroom, y = total_reward)) +
geom_point(size = 3, color = "#00BFFF", alpha = 0.6) +
geom_smooth(method = "lm", color = "black", linetype = "dashed") +
labs(
title = "Correlations between proportion of scene with\nno-associaitons (but high reward) and total reward earned",
