clean_name <- function(name) {
name <- str_trim(name)
# If in "Last, First Middle" format
if (str_detect(name, ",")) {
parts <- str_split(name, ",")[[1]]
last <- str_trim(parts[1])
first_mid <- str_trim(parts[2])
first <- str_split(first_mid, "\\s+")[[1]][1]  # first name only
paste(first, last)
} else {
# In "First Middle Last" format
parts <- str_split(name, "\\s+")[[1]]
first <- parts[1]
last <- parts[length(parts)]
paste(first, last)
}
} %>% Vectorize()
